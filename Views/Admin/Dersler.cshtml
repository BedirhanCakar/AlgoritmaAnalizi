@model IEnumerable<ExamScheduler.Models.Entities.Ders>
@{
    ViewData["Title"] = "Ders Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-primary"><i class="bi bi-book"></i> Ders Yönetimi</h2>
    <a href="#" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Yeni Ders Ekle</a>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-white">Sistemdeki Dersler</h5>
        <span class="badge bg-light text-dark rounded-pill">Toplam: @Model.Count()</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ders Kodu</th>
                        <th>Ders Adı</th>
                        <th>Tür</th>
                        <th>Öğrenci Sayısı</th>
                        <th>Yarıyıl</th>
                        <th>Bölüm</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Henüz hiç ders eklenmemiş.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@item.DersKodu</span></td>
                            <td class="fw-medium">@item.Ad</td>
                            <td>@item.DersTuru</td>
                            <td><i class="bi bi-people"></i> @item.OgrenciSayisi</td>
                            <td>@item.Yariyil. Dönem</td>
                            <td>@(item.Bolum?.Ad ?? "-")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
