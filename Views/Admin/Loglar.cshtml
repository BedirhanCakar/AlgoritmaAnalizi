@model IEnumerable<ExamScheduler.Models.Entities.IslemLog>
@{
    ViewData["Title"] = "İşlem Logları";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Sistem İşlem Logları</h2>
        <div>
            @if (Model.Any())
            {
                <form asp-action="TumLoglariTemizle" method="post" onsubmit="return confirm('Tüm logları silmek istediğinize emin misiniz?');" style="display:inline-block; margin-right: 10px;">
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash-fill"></i> Tüm Logları Temizle</button>
                </form>
            }
            <a href="javascript:history.back()" class="btn btn-outline-secondary">Geri Dön</a>
        </div>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Tarih</th>
                            <th>Kullanıcı</th>
                            <th>İşlem Tipi</th>
                            <th>Tablo</th>
                            <th>Kayıt ID</th>
                            <th>Eski Değer</th>
                            <th>Yeni Değer</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.IslemTarihi.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td>@log.YapanKullanici</td>
                                <td>
                                    @if (log.IslemTipi == "INSERT") { <span class="badge bg-success">@log.IslemTipi</span> }
                                    else if (log.IslemTipi == "UPDATE") { <span class="badge bg-warning text-dark">@log.IslemTipi</span> }
                                    else if (log.IslemTipi == "DELETE") { <span class="badge bg-danger">@log.IslemTipi</span> }
                                    else { <span class="badge bg-secondary">@log.IslemTipi</span> }
                                </td>
                                <td>@log.TabloAdi</td>
                                <td>@log.KayitId</td>
                                <td class="text-muted small">@log.EskiDeger</td>
                                <td class="text-success small">@log.YeniDeger</td>
                                <td class="text-end">
                                    <form asp-action="LogSil" method="post" onsubmit="return confirm('Bu log kaydını silmek istediğinize emin misiniz?');" style="display:inline;">
                                        <input type="hidden" name="id" value="@log.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="text-center p-4 text-muted">Henüz kaydedilmiş bir log bulunmamaktadır. (Örn: Sınav güncellediğinizde burada görünür.)</div>
            }
        </div>
    </div>
</div>
