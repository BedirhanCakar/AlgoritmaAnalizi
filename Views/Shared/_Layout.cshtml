<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExamScheduler</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExamScheduler.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm fixed-top mb-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-calendar-check text-primary"></i> ExamScheduler
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        
                        @if (User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Yönetici İşlemleri
                                    </a>
                                    <ul class="dropdown-menu shadow border-0">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Bolumler"><i class="bi bi-diagram-3 text-primary"></i> Bölümler</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dersler"><i class="bi bi-book text-primary"></i> Dersler</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Derslikler"><i class="bi bi-door-open text-primary"></i> Salonlar (Derslikler)</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Personeller"><i class="bi bi-person-badge text-primary"></i> Personel & Gözetmenler</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Oturumlar"><i class="bi bi-clock text-primary"></i> Oturumlar</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="AkilliAtama"><i class="bi bi-magic text-warning"></i> Akıllı Salon Atama</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="HavuzSistemi"><i class="bi bi-person-lines-fill text-info"></i> Havuz Sistemi (Gözetmen)</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Loglar"><i class="bi bi-journal-code text-secondary"></i> İşlem Logları</a></li>
                                        <li>
                                            <form asp-controller="Admin" asp-action="YedekAl" method="post" class="m-0 p-0 d-inline">
                                                <button type="submit" class="dropdown-item text-success"><i class="bi bi-database-down"></i> Veritabanı Yedeği Al</button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Takvim">Sınav Takvimi</a>
                            </li>
                        }
                    </ul>
                    
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark fw-bold">Hoş Geldiniz, @User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-area="" asp-controller="Account" asp-action="Logout">Çıkış Yap</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-area="" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container" style="margin-top: 100px;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white pt-5 pb-4 mt-5">
        <div class="container text-center text-md-start">
            <div class="row text-center text-md-start">
                <div class="col-md-4 col-lg-4 col-xl-4 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 fw-bold text-primary">ExamScheduler</h5>
                    <p class="text-secondary">
                        Üniversite sınav programlarını, salon atamalarını ve gözetmen eşleştirmelerini en optimum ve adil şekilde yapmanızı sağlayan bulut tabanlı bir sistem.
                    </p>
                </div>

                <div class="col-md-2 col-lg-2 col-xl-2 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 fw-bold">Hızlı Menü</h5>
                    <p><a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none">Ana Sayfa</a></p>
                    <p><a asp-controller="Account" asp-action="Login" class="text-white text-decoration-none">Giriş Yap</a></p>
                    <p><a asp-controller="Account" asp-action="Register" class="text-white text-decoration-none">Kayıt Ol</a></p>
                </div>

                <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 fw-bold">Modüller</h5>
                    <p><a href="#" class="text-white text-decoration-none">Akıllı Atama</a></p>
                    <p><a href="#" class="text-white text-decoration-none">Havuz Sistemi</a></p>
                    <p><a href="#" class="text-white text-decoration-none">Raporlar</a></p>
                </div>

                <div class="col-md-3 col-lg-3 col-xl-3 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 fw-bold">İletişim</h5>
                    <p><i class="bi bi-house-door-fill mr-3"></i> İstanbul, TR</p>
                    <p><i class="bi bi-envelope-fill mr-3"></i> destek@examscheduler.com</p>
                    <p><i class="bi bi-telephone-fill mr-3"></i> +90 555 123 45 67</p>
                </div>
            </div>
            
            <hr class="mb-4">
            
            <div class="row align-items-center">
                <div class="col-md-7 col-lg-8">
                    <p class="text-secondary">
                        &copy; 2026 - Tüm Hakları Saklıdır. Proje Ekibi
                    </p>
                </div>
                <div class="col-md-5 col-lg-4">
                    <div class="text-center text-md-end">
                        <ul class="list-unstyled list-inline">
                            <li class="list-inline-item">
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-github"></i></a>
                            </li>
                            <li class="list-inline-item">
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-twitter"></i></a>
                            </li>
                            <li class="list-inline-item">
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-linkedin"></i></a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
