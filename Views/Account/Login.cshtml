@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0">Sınav Takvimi Sistemi</h4>
                </div>
                <div class="card-body p-4">
                    <h5 class="card-title text-center mb-4">Sisteme Giriş</h5>
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    
                    <form asp-action="Login" method="post">
                        <div class="mb-3">
                            <label class="form-label">Kullanıcı Adı veya E-posta Adresi</label>
                            <input type="text" name="KullaniciAdiOrEposta" class="form-control" placeholder="Kullanıcı adı veya örnek@adres.com" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Şifre</label>
                            <input type="password" name="Sifre" class="form-control" required />
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-dark btn-lg">Giriş Yap</button>
                        </div>
                    </form>
                    
                    <div class="text-center mt-3">
                        <a asp-action="Register" class="text-decoration-none">Hesabın yok mu? Kayıt Ol</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
